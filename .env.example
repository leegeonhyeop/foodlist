# Supabase 연결 정보 견본
# 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 값을 채운다
# 값 위치: Supabase 대시보드 → Project Settings → API

# Project URL (예: https://abcdefgh.supabase.co)
SUPABASE_URL=

# anon public 키 — 브라우저(웹페이지)에 전달됨. RLS가 읽기 전용이라 공개돼도 됨
SUPABASE_ANON_KEY=

# service_role 키 — 관리자 키. RLS를 무시하고 모든 데이터를 바꿀 수 있음
# 웹페이지에는 절대 전달되지 않음. 서버·관리용 스크립트에서만 사용
SUPABASE_SERVICE_ROLE_KEY=
